# Linq Blue API
LINQ_API_TOKEN=your_linq_bearer_token
LINQ_API_BASE_URL=https://api.linqapp.com/api/partner/v3

# MongoDB
# Matches the default docker-compose Mongo credentials.
MONGODB_URI=mongoDB_uri

# Optional (docker-compose): override the mongodb root user/password
MONGO_INITDB_ROOT_USERNAME=usrname
MONGO_INITDB_ROOT_PASSWORD=password
MONGO_INITDB_DATABASE=prepcall

# Gemini
GEMINI_API_KEY=your_gemini_api_key

# Notion
NOTION_TOKEN=your_notion_token
# Notion page id (your resume page; must be shared with the integration)
NOTION_PAGE_ID=

# Server
PORT=3000

# Linq Blue phone numbers this bot runs on (comma-separated, supports multiple)
LINQ_AGENT_BOT_NUMBERS=+6666668886

# Sender phone numbers to ignore (comma-separated)
IGNORED_SENDERS=

# Only respond to these sender numbers (comma-separated) - useful for local dev
ALLOWED_SENDERS=
